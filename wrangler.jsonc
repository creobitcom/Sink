{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Values marked with DEPLOY_* below are placeholders for local/dev.
  // CLI deploy (pnpm deploy:worker / deploy:config) rewrites them into gitignored wrangler.deploy.jsonc.
  // Prefer setting DEPLOY_* in .env or Workers Builds / Pages variables — do not hardcode production IDs here.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "sink" }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "fe97a9277c5845a3a351fc0602925327",
      "id": "fe97a9277c5845a3a351fc0602925327"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink",
      "database_id": "ef964055-65bf-4b78-b109-ac9c9290ae62",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "preview_bucket_name": "sink",
      "bucket_name": "sink"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  },
  "routes": [
    // Cloudflare for SaaS custom hostname routed to this Worker on the creobit.com carrier zone
    { "pattern": "go.8floor.net/*", "zone_name": "creobit.com" }
  ]
}
